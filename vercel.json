{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    },
    {
      "src": "memories/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/callback",
      "dest": "server.py"
    },
    {
      "src": "/memories/(.*)",
      "dest": "/memories/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}